{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bt_companion_level25": {
      "type": "stdio",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${PLUGIN_ROOT}/Launch-MCP.ps1"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env_vars": [
        "CODEX_THREAD_ID",
        "CODEX_SESSION_ID",
        "CODEX_APP_TOOLS_PIPE_PATH",
        "CODEX_MCP_NODE_PATH",
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "CODEX_CLI_PATH",
        "USERPROFILE",
        "USERNAME",
        "USERDOMAIN",
        "LOCALAPPDATA",
        "PATH"
      ],
      "startup_timeout_sec": 15,
      "tool_timeout_sec": 180
    }
  }
}
